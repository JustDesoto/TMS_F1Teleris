# ============================================
# MongoDB (Raw Layer)
# ============================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=f1password123
MONGO_INITDB_DATABASE=f1_pipeline
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=f1password123
MONGO_DATABASE=f1_pipeline
MONGO_AUTH_SOURCE=admin

# ============================================
# OpenF1 API
# ============================================
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_VERIFY_SSL=False
OPENF1_TIMEOUT=60
OPENF1_MAX_RETRIES=5

# ============================================
# PostgreSQL (DDS - Dimensions)
# ============================================
POSTGRES_USER=f1_user
POSTGRES_PASSWORD=f1_password
POSTGRES_DB=f1_dds
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# ClickHouse (DDS - Facts / Analytics)
# ============================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=f1_analytics
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_CONNECTION_PORT=8123

# ============================================
# Superset
# ============================================
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_ADMIN_EMAIL=admin@f1.com
